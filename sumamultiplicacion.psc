Algoritmo sumamultiplicacion
	definir n1,n2,n3,n4,suma,multi Como Entero; 
	escribir "suma de dos numeros";
	escribir "digite el primer numero";
	leer n1;
	escribir "digite el segundo numero";
	leer n2;
	suma=n1+n2;
	escribir "el resultado de la suma es",suma;
	escribir"multiplicacion de dos numeros";
	escribir "digite el primer numero";
	leer n3;
	escribir "digite el segundo numero";
	leer n4;
	multi=n3*n4
	escribir "el resultado de la multiplicacion es:",multi;
	
FinAlgoritmo
